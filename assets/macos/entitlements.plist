<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bun's JavaScriptCore JIT and the zcash.js WASM engine generate code at runtime. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Ad hoc builds load the bundled Electrobun dylibs, which carry their own ad hoc signatures. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- QR scanning; requested only when the scanner opens. -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
